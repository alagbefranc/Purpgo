# Names only. Leave values empty in git. Generate them on the operator machine
# and pass them to `fly secrets set`. Never commit filled-in copies.
#
# Required before APP_ENV=prod will boot
APP_ENV=
AUTH_SECRET=
INTERNAL_API_TOKEN=
SECRET_KEY_BASE=
KMS_LOCAL_MASTER_KEY=
CREDENTIALS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
PRIMARY_DB=
REDIS=
NATS_URL=
JWT_SECRET=
DATABASE_URL=
ENCRYPTED_KEYS_WORKER_TOKEN=

# Public URLs (values are hostnames, still not committed here)
APP_URL=
API_PUBLIC_URL=
CORS_ALLOW_ORIGINS=
WEBSOCKET_URL=
PHX_HOST=
CHECK_ORIGIN_HOSTS=
TRACKING_DOMAIN=
FORMS_DOMAIN=
BACKEND_INTERNAL_URL=
ENCRYPTED_KEYS_BACKEND_URL=

# Blobs on Cloudflare R2
BLOB_PROVIDER=
BLOB_BUCKET=
BLOB_PUBLIC_BASE_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=

# Transactional mail (new subdomain only; do not reuse apex MX)
MAIL_TRANSPORT=
EMAIL_NAME=
EMAIL_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=
EMAIL_BRAND_NAME=
EMAIL_BRAND_LEGAL_ENTITY=
EMAIL_BRAND_WEBSITE_URL=
EMAIL_BRAND_SUPPORT_EMAIL=
EMAIL_BRAND_TERMS_URL=
EMAIL_BRAND_PRIVACY_URL=

# Injected into the static dashboard and admin at container start
PURPGO_API_URL=
PURPGO_APP_URL=
PURPGO_DASHBOARD_URL=
PURPGO_ENV_LABEL=

# Optional for v1. Leave unset rather than blank when the service treats
# an empty string as a hard failure (Sentry on the realtime image).
BOX_OUTLOOK_CLIENT_ID=
BOX_OUTLOOK_CLIENT_SECRET=
BOX_GOOGLE_OAUTH_CONNECT=
BOX_GOOGLE_CLIENT_ID=
BOX_GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
CAPTCHA_PROVIDER=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
PURPGO_TURNSTILE_KEY=
UNSUBSCRIBE_SIGNING_SECRET=
TWOFA_SECRET=
GEODB_URL=
TRACKING_IP_HASH_KEY=
TRUSTED_PROXIES=
MAIL_TLS_INSECURE=
