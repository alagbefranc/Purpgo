#!/bin/sh
set -eu
hostnamectl set-hostname '${name}'
retry() {
  attempts=0
  while ! "$@"; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 24 ]; then return 1; fi
    sleep 5
  done
  return 0
}
retry dnf -y --setopt=retries=20 install docker
systemctl enable --now docker
install -d -m 700 /etc/purpgo /var/lib/purpgo /var/lib/purpgo/node
printf '%s\n' 'PURPGO_IMAGE_REF=${image}' > /var/lib/purpgo/image-ref
chmod 600 /var/lib/purpgo/image-ref
cat > /etc/systemd/system/purpgo-worker.service <<'UNIT'
[Unit]
Description=Purpgo worker
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/etc/purpgo/node.env

[Service]
Restart=always
RestartSec=5
EnvironmentFile=/var/lib/purpgo/image-ref
ExecStartPre=-/usr/bin/docker rm -f purpgo-worker
ExecStart=/usr/bin/docker run --rm --name purpgo-worker --env-file /etc/purpgo/node.env --env AWS_EC2_METADATA_DISABLED=true --network host -v /var/lib/purpgo/node:/var/lib/purpgo/node $${PURPGO_IMAGE_REF}
ExecStop=/usr/bin/docker stop -t 120 purpgo-worker
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
retry docker pull '${image}'
printf '%s\n' 'Worker host ready; service stays stopped until an operator completes the handover'
