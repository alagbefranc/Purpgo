---
// Modified by Purpgo LLC.
import Layout from '../../layouts/Layout.astro';
import { guide, groups, href, type GuidePage } from '../../lib/guide';

interface Props { page: GuidePage }
const { page } = Astro.props;
const idx = guide.findIndex((p) => p.slug === page.slug);
const prev = guide[idx - 1];
const next = guide[idx + 1];
const slugify = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const searchIndex = guide.map((p) => ({
  t: p.title, u: href(p.slug), g: p.group,
  x: [p.summary, p.where, ...p.sections.flatMap((s) => [s.heading, ...s.body, ...(s.list ?? [])])].join(' '),
  h: p.sections.map((s) => [s.heading, `${href(p.slug)}#${slugify(s.heading)}`]),
}));
---
<Layout title={`${page.title} · Purpgo guide`} description={page.summary}>
  <div class="guide mx-auto w-full max-w-[1400px] px-5 md:px-8 pt-28 md:pt-32 pb-24">
    <div class="lg:grid lg:grid-cols-[232px_minmax(0,1fr)_180px] lg:gap-14">
      <!-- Left nav -->
      <aside class="lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto pb-6">
        <a href="/guide/" class="text-[13px] font-semibold uppercase tracking-[0.12em] text-brand">Purpgo guide</a>
        <div class="relative mt-4">
          <svg aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="guide-search" type="search" placeholder="Search the guide" autocomplete="off"
            class="w-full rounded-[10px] border border-border bg-surface pl-9 pr-3 py-2 text-[14px] text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring/40 focus:border-ring" />
          <div id="guide-results" hidden class="absolute z-30 mt-2 w-full lg:w-[420px] rounded-[12px] border border-border bg-surface shadow-[var(--shadow-md)] p-1.5 max-h-[60vh] overflow-y-auto"></div>
        </div>
        <details class="lg:hidden mt-4 rounded-[12px] border border-border bg-surface-2 group">
          <summary class="cursor-pointer list-none px-4 py-3 text-[14px] font-medium text-heading flex justify-between items-center">
            <span>Contents · {page.title}</span><span class="text-muted-foreground group-open:rotate-180 transition">▾</span>
          </summary>
          <nav class="px-4 pb-3">
            {groups.map((g) => (
              <div class="mt-3">
                <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">{g}</p>
                {guide.filter((p) => p.group === g).map((p) => (
                  <a href={href(p.slug)} class:list={['block py-1.5 text-[14px]', p.slug === page.slug ? 'text-brand font-medium' : 'text-foreground/80']}>{p.title}</a>
                ))}
              </div>
            ))}
          </nav>
        </details>
        <nav class="hidden lg:block mt-6" aria-label="Guide">
          {groups.map((g) => (
            <div class="mb-5">
              <p class="mb-1.5 px-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">{g}</p>
              {guide.filter((p) => p.group === g).map((p) => (
                <a href={href(p.slug)} aria-current={p.slug === page.slug ? 'page' : undefined}
                  class:list={['block rounded-[8px] px-3 py-1.5 text-[14px] transition-colors', p.slug === page.slug ? 'bg-brand/10 text-brand font-medium' : 'text-foreground/75 hover:text-heading hover:bg-surface-2']}>{p.title}</a>
              ))}
            </div>
          ))}
        </nav>
      </aside>

      <!-- Article -->
      <article class="min-w-0">
        <p class="text-[13px] font-medium text-muted-foreground">Guide <span class="mx-1.5">/</span> {page.group}</p>
        <h1 class="mt-3 text-[38px] md:text-[52px] leading-[1.05] font-semibold tracking-[-0.03em] text-heading">{page.title}</h1>
        <p class="mt-5 max-w-[680px] text-[18px] md:text-[20px] leading-[1.55] text-muted-foreground">{page.summary}</p>

        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          <div class="rounded-[14px] border border-border bg-surface-2 p-5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-brand">Where to find it</p>
            <p class="mt-2 text-[15px] leading-[1.55] text-foreground">{page.where}</p>
          </div>
          <div class="rounded-[14px] border border-border bg-surface-2 p-5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-brand">Why it matters</p>
            <p class="mt-2 text-[15px] leading-[1.55] text-foreground">{page.why}</p>
          </div>
        </div>

        {page.sections.map((s) => (
          <section id={slugify(s.heading)} class="mt-14 scroll-mt-28">
            <h2 class="text-[26px] md:text-[30px] font-semibold tracking-[-0.02em] text-heading">{s.heading}</h2>
            {s.body.map((b) => <p class="mt-4 max-w-[720px] text-[16.5px] leading-[1.7] text-foreground/85">{b}</p>)}
            {s.list && (
              <ol class="mt-5 max-w-[720px] space-y-3">
                {s.list.map((li, i) => (
                  <li class="flex gap-4 text-[16px] leading-[1.6] text-foreground/85">
                    <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-brand/10 text-[13px] font-semibold text-brand">{i + 1}</span>
                    <span>{li}</span>
                  </li>
                ))}
              </ol>
            )}
            {s.shot && (
              <figure class="mt-7">
                <div class:list={['overflow-hidden rounded-[14px] border border-border bg-surface-2 shadow-[var(--shadow-md)]', s.shot.w < 1000 && 'max-w-[600px]']}>
                  <img src={s.shot.src} alt={s.shot.alt} width={s.shot.w} height={s.shot.h} loading="lazy" decoding="async" class="block w-full h-auto" />
                </div>
                {s.shot.caption && <figcaption class="mt-3 text-[13.5px] text-muted-foreground">{s.shot.caption}</figcaption>}
              </figure>
            )}
          </section>
        ))}

        <nav class="mt-20 grid gap-3 sm:grid-cols-2 border-t border-border pt-8" aria-label="Next and previous">
          {prev ? (
            <a href={href(prev.slug)} class="rounded-[14px] border border-border p-5 hover:border-brand/40 hover:bg-surface-2 transition">
              <span class="text-[12px] text-muted-foreground">← Previous</span><span class="mt-1 block font-medium text-heading">{prev.title}</span>
            </a>
          ) : <span />}
          {next && (
            <a href={href(next.slug)} class="rounded-[14px] border border-border p-5 text-right hover:border-brand/40 hover:bg-surface-2 transition">
              <span class="text-[12px] text-muted-foreground">Next →</span><span class="mt-1 block font-medium text-heading">{next.title}</span>
            </a>
          )}
        </nav>
        <p class="mt-10 text-[14px] text-muted-foreground">Ready to try it? <a class="text-brand font-medium hover:underline" href="https://app.purpgo.com">Open app.purpgo.com →</a></p>
      </article>

      <!-- On this page -->
      <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">On this page</p>
        <ul class="mt-3 space-y-2 border-l border-border">
          {page.sections.map((s) => <li><a href={`#${slugify(s.heading)}`} class="-ml-px block border-l border-transparent pl-3 text-[13.5px] text-foreground/70 hover:text-brand hover:border-brand">{s.heading}</a></li>)}
        </ul>
      </aside>
    </div>
  </div>
  <script type="application/json" id="guide-index" set:html={JSON.stringify(searchIndex)} />
</Layout>

<script>
  type Entry = { t: string; u: string; g: string; x: string; h: [string, string][] };
  const input = document.getElementById('guide-search') as HTMLInputElement | null;
  const box = document.getElementById('guide-results') as HTMLDivElement | null;
  const data: Entry[] = JSON.parse(document.getElementById('guide-index')?.textContent || '[]');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function snippet(text: string, q: string) {
    const i = text.toLowerCase().indexOf(q);
    if (i < 0) return '';
    const start = Math.max(0, i - 40);
    const raw = (start ? '…' : '') + text.slice(start, i + q.length + 70) + '…';
    return esc(raw).replace(new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'ig'), (m) => `<mark class="bg-brand/15 text-heading rounded px-0.5">${m}</mark>`);
  }
  function render() {
    if (!input || !box) return;
    const q = input.value.trim().toLowerCase();
    if (q.length < 2) { box.hidden = true; box.innerHTML = ''; return; }
    const hits: string[] = [];
    for (const e of data) {
      const head = e.h.find(([h]) => h.toLowerCase().includes(q));
      const inTitle = e.t.toLowerCase().includes(q);
      const sn = snippet(e.x, q);
      if (!inTitle && !head && !sn) continue;
      const url = head ? head[1] : e.u;
      hits.push(`<a href="${url}" class="block rounded-[8px] px-3 py-2.5 hover:bg-surface-2"><span class="block text-[14px] font-medium text-heading">${esc(e.t)}${head ? ` <span class="text-muted-foreground font-normal">› ${esc(head[0])}</span>` : ''}</span>${sn ? `<span class="mt-0.5 block text-[12.5px] leading-[1.5] text-muted-foreground">${sn}</span>` : ''}</a>`);
    }
    box.innerHTML = hits.length ? hits.join('') : `<p class="px-3 py-3 text-[13.5px] text-muted-foreground">No matches for “${esc(input.value)}”.</p>`;
    box.hidden = false;
  }
  input?.addEventListener('input', render);
  input?.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter') { const a = box?.querySelector('a'); if (a) location.href = (a as HTMLAnchorElement).href; }
    if (ev.key === 'Escape') { input.value = ''; render(); }
  });
  document.addEventListener('click', (ev) => { if (box && !box.contains(ev.target as Node) && ev.target !== input) box.hidden = true; });
  document.addEventListener('keydown', (ev) => { if (ev.key === '/' && document.activeElement !== input) { ev.preventDefault(); input?.focus(); } });
</script>
